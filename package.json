{
  "name": "dsh-llm-codex-app-server",
  "version": "0.1.20",
  "description": "DeepSeek Harness LLM provider backed by the locally authenticated Codex App Server",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wss534857356/dsh-plugin-codex.git"
  },
  "homepage": "https://github.com/wss534857356/dsh-plugin-codex#readme",
  "bugs": {
    "url": "https://github.com/wss534857356/dsh-plugin-codex/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/**/*.d.ts",
    "docs/adr",
    "docs/app-server-provider-plan.md",
    "docs/architecture.md",
    "docs/releasing.md",
    "docs/releasing.zh.md",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "check": "pnpm run release:verify && pnpm pack --pack-destination dist",
    "clean": "rimraf lib dist coverage",
    "package:verify": "node scripts/verify-package.mjs",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run release:verify",
    "release:verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run package:verify",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "codex",
    "llm",
    "plugin"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-attachment": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-web": ">=0.1.2-alpha.1 <0.2.0",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@openai/codex": "0.147.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-brand": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-attachment": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-subprocess-local": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-timeout": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-web": "0.1.2-alpha.1",
    "@types/node": "^24.10.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "lightningcss": "^1.30.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
